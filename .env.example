# SupportLoop environment variables.
# Copy to .env.local and fill in. The same values go in Vercel project settings.

# --- Anthropic (server-side only) ---
ANTHROPIC_API_KEY=

# --- Voyage AI embeddings (server-side only) ---
VOYAGE_API_KEY=

# --- Supabase ---
# URL + anon key are the only values exposed to the browser (NEXT_PUBLIC_*).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is server-only: used by seed + write routes. Never expose it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Scheduled jobs ---
# Bearer token Vercel Cron sends to /api/cron/sla (the all-org SLA breach sweep).
# Required in any deployment running the cron: the route fails closed without it.
CRON_SECRET=

# --- Rate limiting (optional; protects the public demo from LLM cost abuse) ---
# Create a free Upstash Redis (https://upstash.com) and paste its REST URL + token.
# If unset, rate limiting is disabled — fine for local dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional tuning (defaults shown):
# RATELIMIT_IP_PER_MIN=15
# RATELIMIT_GLOBAL_PER_DAY=2000
